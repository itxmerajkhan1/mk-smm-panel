rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default fallback - close all access by default (The Global Safety Net)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions for auth verification
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && 
             request.auth.token.email_verified == true && (
               request.auth.token.email == "itxmerajkhan3109@gmail.com" || 
               request.auth.token.email == "admin@mksmm.com"
             ) &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Standard string and ID validity checker
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation Blueprint for user profiles
    function isValidUser(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.username is string && data.username.size() <= 128 &&
             data.email is string && data.email.size() <= 128 &&
             data.role is string && (data.role == 'admin' || data.role == 'user' || data.role == 'superadmin') &&
             data.balance is number && data.balance >= 0.0 &&
             data.status is string && (data.status == 'active' || data.status == 'suspended') &&
             data.apiKey is string && data.apiKey.size() <= 128 &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    // User account rules
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      
      allow create: if (
        isSignedIn() && isOwner(userId) && isValidUser(request.resource.data) && 
        (
          (request.auth.token.email == "itxmerajkhan3109@gmail.com" || request.auth.token.email == "admin@mksmm.com") ? 
          request.resource.data.role == 'admin' : 
          request.resource.data.role == 'user'
        ) && 
        request.resource.data.balance == 0.0
      ) || (
        isAdmin() && isValidUser(request.resource.data)
      );
      
      allow update: if (
        isOwner(userId) && 
        isValidUser(request.resource.data) &&
        request.resource.data.role == resource.data.role && 
        request.resource.data.id == resource.data.id &&
        request.resource.data.username == resource.data.username &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['apiKey', 'balance', 'referredBy', 'referralEarnings', 'referralCount'])
      ) || isAdmin();
    }

    // Validation Blueprint for Wallets
    function isValidWallet(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.USD is number && data.USD >= 0.0 &&
             data.PKR is number && data.PKR >= 0.0 &&
             data.EUR is number && data.EUR >= 0.0 &&
             data.GBP is number && data.GBP >= 0.0 &&
             data.currency is string && data.currency.size() <= 16 &&
             data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    // Wallets multi-currency rules
    match /wallets/{walletId} {
      allow get: if isOwner(walletId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn() && isOwner(walletId) && isValidWallet(request.resource.data);
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Referrals Program rules
    match /referrals/{referralId} {
      allow get, list: if isSignedIn() && (resource.data.referrerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Commissions rules
    match /commissions/{commissionId} {
      allow get, list: if isSignedIn() && (resource.data.referrerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Announcements board
    match /announcements/{announcementId} {
      allow read: if true;
      allow list: if isSignedIn();
      allow write: if isAdmin();
    }

    // Validation Blueprint for Orders
    function isValidOrder(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.serviceId is string && data.serviceId.size() <= 128 &&
             data.link is string && data.link.size() <= 2048 &&
             data.quantity is int && data.quantity >= 0 &&
             data.charge is number && data.charge >= 0.0 &&
             data.startCount is int && data.startCount >= 0 &&
             data.remains is int && data.remains >= 0 &&
             data.status is string && (data.status == 'pending' || data.status == 'processing' || data.status == 'in_progress' || data.status == 'completed' || data.status == 'partial' || data.status == 'canceled') &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    // Service Orders rules
    match /orders/{orderId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      
      allow create: if (
        isSignedIn() && 
        request.resource.data.userId == request.auth.uid && 
        isValidOrder(request.resource.data) &&
        request.resource.data.status == 'pending'
      ) || isAdmin();
      
      allow update: if (
        isAdmin() && isValidOrder(request.resource.data)
      ) || (
        isSignedIn() && 
        resource.data.userId == request.auth.uid && 
        isValidOrder(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        (request.resource.data.status == 'processing' || request.resource.data.status == 'canceled')
      );
      
      allow delete: if false;
    }

    // Validation Blueprint for Tickets
    function isValidTicket(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.subject is string && data.subject.size() <= 256 &&
             data.message is string && data.message.size() <= 10000 &&
             data.status is string && (data.status == 'open' || data.status == 'answered' || data.status == 'closed') &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    // Tickets rules
    match /tickets/{ticketId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && isValidTicket(request.resource.data);
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin()) && isValidTicket(request.resource.data);
      allow delete: if false;
    }

    // Validation Blueprint for Transactions
    function isValidTransaction(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.amount is number && data.amount >= 0.0 &&
             data.method is string && data.method.size() <= 128 &&
             data.status is string && (data.status == 'pending' || data.status == 'completed' || data.status == 'failed') &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    // Transactions log ledger
    match /transactions/{transactionId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      
      allow create: if (
        isSignedIn() && 
        request.resource.data.userId == request.auth.uid && 
        isValidTransaction(request.resource.data) &&
        request.resource.data.status == 'pending'
      ) || (
        isAdmin() && isValidTransaction(request.resource.data)
      );
      
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Validation Blueprint for Client Notifications
    function isValidNotification(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.title is string && data.title.size() <= 256 &&
             data.message is string && data.message.size() <= 2048 &&
             data.read is bool &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    // Client Notifications
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidNotification(request.resource.data);
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin()) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // SMM Wholesale Provider integrations
    match /providers/{providerId} {
      allow read, write: if isAdmin();
    }

    // Public catalog services details
    match /services/{serviceId} {
      allow read, list: if true;
      allow write: if isAdmin();
    }

    // Public categories matching
    match /categories/{categoryId} {
      allow read, list: if true;
      allow write: if isAdmin();
    }

    // Operations audit logs ledger
    match /auditLogs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Legacy password fallback credentials
    match /passwords_legacy/{userId} {
      allow read, write: if isAdmin();
    }

    // Settings config mapping
    match /settings/{docName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Connection testing probe
    match /test-connection-probe/{docId} {
      allow read: if true;
    }
  }
}
