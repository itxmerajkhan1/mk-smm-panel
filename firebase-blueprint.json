{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile inside the system",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "balance": { "type": "number" },
        "status": { "type": "string" },
        "apiKey": { "type": "string" },
        "createdAt": { "type": "string" },
        "referredBy": { "type": "string" },
        "referralEarnings": { "type": "number" },
        "referralCount": { "type": "integer" }
      },
      "required": ["id", "username", "email", "role", "balance", "status", "apiKey", "createdAt"]
    },
    "Wallet": {
      "title": "User Multi-Currency Wallet",
      "description": "Tracks balance across multiple synced fiat currencies",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "USD": { "type": "number" },
        "PKR": { "type": "number" },
        "EUR": { "type": "number" },
        "GBP": { "type": "number" },
        "currency": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "USD", "PKR", "EUR", "GBP", "currency", "updatedAt"]
    },
    "Order": {
      "title": "SMM Order",
      "description": "Placed order for SMM services",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "serviceId": { "type": "string" },
        "link": { "type": "string" },
        "quantity": { "type": "integer" },
        "charge": { "type": "number" },
        "startCount": { "type": "integer" },
        "remains": { "type": "integer" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "providerPrice": { "type": "number" },
        "providerCost": { "type": "number" },
        "profit": { "type": "number" }
      },
      "required": ["id", "userId", "serviceId", "link", "quantity", "charge", "startCount", "remains", "status", "createdAt"]
    },
    "Ticket": {
      "title": "Support Ticket",
      "description": "Support issues submitted by clients",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "replies": { "type": "array" }
      },
      "required": ["id", "userId", "subject", "message", "status", "createdAt"]
    },
    "Transaction": {
      "title": "Financial Transaction",
      "description": "Deposit and withdrawal transactions ledger",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "method": { "type": "string" },
        "status": { "type": "string" },
        "type": { "type": "string" },
        "senderDetails": { "type": "string" },
        "screenshotUrl": { "type": "string" },
        "adminNotes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "amount", "method", "status", "createdAt"]
    },
    "Notification": {
      "title": "Client Notification",
      "description": "Realtime notification messages",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "message", "read", "createdAt"]
    },
    "Provider": {
      "title": "Reseller API Provider",
      "description": "Supplier API configuration and keys",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "apiType": { "type": "string" },
        "url": { "type": "string" },
        "apiKey": { "type": "string" },
        "balance": { "type": "number" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "apiType", "url", "active", "createdAt"]
    },
    "Service": {
      "title": "SMM Service",
      "description": "Reseller and system SMM catalog entries",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "category": { "type": "string" },
        "name": { "type": "string" },
        "rate": { "type": "number" },
        "min": { "type": "integer" },
        "max": { "type": "integer" },
        "active": { "type": "boolean" },
        "description": { "type": "string" },
        "refill": { "type": "boolean" },
        "cancel": { "type": "boolean" },
        "providerId": { "type": "string" },
        "originalServiceId": { "type": "string" },
        "providerPrice": { "type": "number" },
        "customerPrice": { "type": "number" },
        "profitAmount": { "type": "number" }
      },
      "required": ["id", "category", "name", "rate", "min", "max", "active"]
    },
    "Category": {
      "title": "Service Category",
      "description": "Grouping categories for services catalogue",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "icon": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "name", "icon", "active"]
    },
    "Referral": {
      "title": "Referral Linkage",
      "description": "SMM panel referral affiliate signups",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "referrerId": { "type": "string" },
        "referredId": { "type": "string" },
        "referredUsername": { "type": "string" },
        "referredEmail": { "type": "string" },
        "commissionsEarned": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "referrerId", "referredId", "referredUsername", "referredEmail", "createdAt"]
    },
    "Commission": {
      "title": "Referral Commission Audit",
      "description": "Commissions earned by referring users upon their top-ups",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "referrerId": { "type": "string" },
        "referredId": { "type": "string" },
        "referredUsername": { "type": "string" },
        "transactionId": { "type": "string" },
        "transactionAmount": { "type": "number" },
        "commissionAmount": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "referrerId", "referredId", "referredUsername", "transactionId", "transactionAmount", "commissionAmount", "createdAt"]
    },
    "Announcement": {
      "title": "Announcement Board Node",
      "description": "Announcements made by administrators on panel billboard",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "content", "active", "createdAt"]
    },
    "AuditLog": {
      "title": "System Security Audit Log",
      "description": "Security events and action records executed in platform",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "username", "action", "details", "createdAt"]
    },
    "PanelSettings": {
      "title": "Panel Settings Configuration",
      "description": "Operational margins and parameters of system",
      "type": "object",
      "properties": {
        "panelName": { "type": "string" },
        "currency": { "type": "string" },
        "maintenanceMode": { "type": "boolean" },
        "minDeposit": { "type": "number" },
        "maxDeposit": { "type": "number" },
        "autoSyncServices": { "type": "boolean" },
        "autoSyncIntervalHours": { "type": "integer" },
        "lastSyncTime": { "type": "string" }
      },
      "required": ["panelName", "currency", "maintenanceMode", "minDeposit", "maxDeposit", "autoSyncServices", "autoSyncIntervalHours"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/entities/User",
      "description": "SMM user accounts"
    },
    "/wallets/{walletId}": {
      "schema": "#/entities/Wallet",
      "description": "Tracks multi-currency wallets mapped directly to UID"
    },
    "/orders/{orderId}": {
      "schema": "#/entities/Order",
      "description": "SMM orders placed by users"
    },
    "/tickets/{ticketId}": {
      "schema": "#/entities/Ticket",
      "description": "User support tickets"
    },
    "/transactions/{transactionId}": {
      "schema": "#/entities/Transaction",
      "description": "Wallet addition transaction ledger"
    },
    "/notifications/{notificationId}": {
      "schema": "#/entities/Notification",
      "description": "User system and broadcast notifications"
    },
    "/providers/{providerId}": {
      "schema": "#/entities/Provider",
      "description": "Third-party wholesaler SMM services providers"
    },
    "/services/{serviceId}": {
      "schema": "#/entities/Service",
      "description": "All SMM services resold on panel"
    },
    "/categories/{categoryId}": {
      "schema": "#/entities/Category",
      "description": "Grouping categories for list separation"
    },
    "/referrals/{referralId}": {
      "schema": "#/entities/Referral",
      "description": "Users tracking affiliate link conversions"
    },
    "/commissions/{commissionId}": {
      "schema": "#/entities/Commission",
      "description": "Affiliate referral payouts ledger"
    },
    "/announcements/{announcementId}": {
      "schema": "#/entities/Announcement",
      "description": "System billboard updates and alerts"
    },
    "/auditLogs/{logId}": {
      "schema": "#/entities/AuditLog",
      "description": "Operations audit ledger"
    },
    "/settings/panel_config": {
      "schema": "#/entities/PanelSettings",
      "description": "System config details"
    }
  }
}
